# Pithros — simulation environment template (NAMES + placeholders only).
#
# Copy to runtime/app.env (mode 600) at the repository root of the VM checkout and fill in real test/staging values
# in your own terminal. NEVER commit a filled copy. NEVER paste values into chat.
#
# This single file is used two ways by the simulation stack:
#   1. compose variable substitution  (docker compose --env-file …)
#   2. container environment          (env_file: /opt/pithros/env/app.env)

# ─── runtime ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEMO_MODE=false
LOG_LEVEL=INFO
LOG_JSON=true
APP_BASE_URL=http://10.153.175.57
FRONTEND_BASE_URL=http://10.153.175.57
CORS_ORIGINS=http://10.153.175.57

# ─── database — external DEDICATED Supabase TEST/STAGING ────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── redis — internal to the VM ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── firebase — project pithros-dev ─────────────────────────────────────────
FIREBASE_PROJECT_ID=pithros-dev
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# ─── storage — Cloudflare R2 test bucket/prefix ─────────────────────────────
STORAGE_BACKEND=s3
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_REGION=auto
R2_BUCKET_PUBLIC=pithros-public
R2_BUCKET_PRIVATE=pithros-private
R2_BUCKET_SENSITIVE=pithros-sensitive
R2_PUBLIC_BASE_URL=https://PUBLIC_BUCKET_DOMAIN
R2_PRESIGN_EXPIRY_SECONDS=900

# ─── email — Mailpit on the simulation ──────────────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=no-reply@pithros.in
EMAIL_FROM_NAME=Pithros

# ─── cashfree — REAL TRANSACTIONS INTENTIONALLY DEFERRED ────────────────────
# Leave these unset/empty: the live gateway stays disabled and fails closed (503).
# The backend test simulator is NOT reachable from this stack.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_BASE_URL=

# ─── security / limits ──────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
IDEMPOTENCY_ENABLED=true
MAX_UPLOAD_BYTES=26214400

# ─── lifecycle / feature flags ──────────────────────────────────────────────
INVITE_TOKEN_TTL_HOURS=168
EXPOSE_INVITATION_TOKENS=false
ACCOUNT_DELETION_GRACE_DAYS=7
RECENT_REAUTH_WINDOW_MINUTES=15
VERIFICATION_DOCUMENT_RETENTION_DAYS=90

# ─── frontend build args (compose substitution) ─────────────────────────────
VITE_API_BASE_URL=http://10.153.175.57
VITE_DEMO_MODE=false
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=pithros-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pithros-dev
VITE_FIREBASE_STORAGE_BUCKET=pithros-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
