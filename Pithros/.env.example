# Client-side configuration. Copy to .env.development (gitignored) and fill in.
#
# Vite loads .env.development automatically for `npm run dev` and
# .env.production for `npm run build`.

# Where the FastAPI backend lives.
VITE_API_BASE_URL=http://localhost:8000

# Explicit. 'true' uses the in-browser demo data and needs no backend;
# 'false' calls the real API and requires the backend plus Firebase.
# Production builds must use 'false'.
VITE_DEMO_MODE=true

# Firebase Authentication (client-side).
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# Leaving these blank keeps the app in demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
