# Pithros backend — environment template.
# Copy to .env.development (local) or .env.production (server) and fill in.
# Never commit a file containing real secrets.

# ─── Runtime ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_JSON=false

APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://pithros:pithros@localhost:5432/pithros
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ─── Redis (Celery broker, cache, rate limiting) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Firebase Admin (identity) ──────────────────────────────────────────────
# Preferred: path to the service-account JSON downloaded from Firebase.
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# Alternative: supply the three fields individually (useful in container envs).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Cloudflare R2 / S3-compatible object storage ───────────────────────────
# STORAGE_BACKEND=local writes uploads to disk (development only; refused in
# production). STORAGE_BACKEND=s3 uses R2 or any S3-compatible service.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=var/media

R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_PUBLIC=pithros-public
R2_BUCKET_PRIVATE=pithros-private
R2_BUCKET_SENSITIVE=pithros-sensitive
# Public CDN base for the public bucket. Empty = signed URLs for everything.
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRY_SECONDS=900

# ─── Payments (server-side only; these must never reach the browser) ────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ─── Security ───────────────────────────────────────────────────────────────
# Comma-separated. No wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true

# ─── Uploads ────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400

# ─── Celery ─────────────────────────────────────────────────────────────────
CELERY_TASK_ALWAYS_EAGER=false

INVITE_TOKEN_TTL_HOURS=168

# ─── Outbound email (receipts) ──────────────────────────────────────────────
# Disabled by default. Point at Mailpit locally (127.0.0.1:1025) or a real
# SMTP provider in production. Credentials belong in the gitignored .env.local.
EMAIL_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=no-reply@pithros.in
EMAIL_FROM_NAME=Pithros
