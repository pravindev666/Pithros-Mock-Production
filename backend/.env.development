# Local development. Safe defaults only — no real secrets belong here.
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_JSON=false

APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://pithros:pithros@localhost:5432/pithros
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Drop your Firebase service-account JSON at backend/secrets/ to enable real auth.
# Without it the backend still starts; token verification reports a clear error.
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# Dev uploads go to disk under backend/var/media. Set STORAGE_BACKEND=s3 and fill
# the R2_* values below to test against real Cloudflare R2 instead.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=var/media

# Cloudflare R2 (used when STORAGE_BACKEND=s3)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_PUBLIC=pithros-public
R2_BUCKET_PRIVATE=pithros-private
R2_BUCKET_SENSITIVE=pithros-sensitive
R2_PUBLIC_BASE_URL=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true

CELERY_TASK_ALWAYS_EAGER=false
